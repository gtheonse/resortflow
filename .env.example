# LLM access — the only paid dependency. Configure EITHER a plain Azure OpenAI resource
# (AZURE_OPENAI_ENDPOINT) OR an Azure AI Foundry project (FOUNDRY_PROJECT_ENDPOINT); both are
# OpenAI-compatible and share AZURE_OPENAI_API_KEY. Provider selection is which variables are
# populated, never a code branch. With neither set, LLM-dependent steps degrade to the
# deterministic fallbacks and the eval judge reports INCOMPLETE rather than inventing a score.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_JUDGE_DEPLOYMENT_NAME=
FOUNDRY_GENERATION_DEPLOYMENT_NAME=
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=
LLM_PROVIDER=azure-foundry
MODEL_CHEAP=gpt-4.1-mini
MODEL_FRONTIER=gpt-4.1
MODEL_JUDGE=gpt-4.1

# Local infra
POSTGRES_URL=postgresql://resortflow:resortflow@localhost:5432/resortflow
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Checkpoint encryption (generate: openssl rand -base64 32)
LANGGRAPH_AES_KEY=

# Observability
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000

# Simulated vendors
PMS_SIM_URL=http://localhost:9001
DINING_SIM_URL=http://localhost:9002
TICKETING_SIM_URL=http://localhost:9003
CASINO_SIM_URL=http://localhost:9004
AMENITIES_SIM_URL=http://localhost:9005

# MCP gateway (mcp/gateway/) — dev-only local fixtures, never real credentials.
# MCP_DEV_SIGNING_KEY signs/verifies the dev token issuer (gateway._shared.identity);
# `make seed` generates one if this is left blank. The five *_SIM_URL vars above are
# reused by the gateway itself as its upstream targets — no separate copies needed.
MCP_DEV_SIGNING_KEY=

# Vendor credentials the gateway presents to each sim (mcp/gateway/_shared/vendor_auth.py).
# Fixture values only, matching each sim's own hardcoded local-dev expectations
# (sims/*/main.py) — never real-looking hostnames or secrets (Phase 1 convergence finding).
DINING_API_KEY=dining-sim-static-key-MRI
TICKETING_CLIENT_ID=ticketing-sim-client
TICKETING_CLIENT_SECRET=ticketing-sim-client-secret
PMS_CLIENT_ID=pms-sim-client
PMS_CLIENT_SECRET=pms-sim-client-secret
AMENITIES_USERNAME=amenities-mcp
AMENITIES_PASSWORD=amenities-sim-secret
CASINO_BEARER_TOKEN=casino-sim-static-bearer-token

# Prompt registry (feature 009, ADR-052). Git-canonical; Langfuse is an optional mirror.
PROMPT_SOURCE=git                 # git | langfuse (git = files in the image; no registry needed)
PROMPT_LABEL=production           # registry label for label-resolved prompts (staging for local trials)
PROMPT_CACHE_TTL_SECONDS=60       # SDK cache TTL (stale-while-revalidate)
PROMPT_FETCH_TIMEOUT_SECONDS=2    # registry fetch timeout
# LANGFUSE_HOST must be set explicitly for registry mode (the SDK's cloud default is never used).
# REBASELINE_TOKEN=               # CI-only fine-grained PAT secret (rebaseline job); never put a real value here
